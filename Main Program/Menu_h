#ifndef Menu_H
#define Menu_H
#include <iostream>
#include<vector>
#include "Juice_H"
using namespace std;
class Menu{ //Class:Menu,  Manages a collection of juice objects available for sale.
private:
vector<juice> availableJuices; //Dynamic list to store the different juice objects.
public:
Void AddJuice(juice j){
availableJuices.push_back(j); //Adds a new juice object to the end of the availableJuices list.
}
void ShowMenu(){
cout<<"Available Juices"<<endl;
for (int i=0; i< availableJuices.size() ; i++){
availableJuices[i].displayJuiceInfo();
cout<<endl;} //goes through the list and calls the display function for each juice
};
};
#endif
